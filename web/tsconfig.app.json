{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Tests are typechecked by tsconfig.test.json, not here. They read Go
     fixtures from ../../internal, which the production build does not have:
     the Docker web stage copies web/ alone. Keeping them out of the app
     project is what lets that build typecheck the app it actually ships. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/setupTests.ts", "src/test"]
}
